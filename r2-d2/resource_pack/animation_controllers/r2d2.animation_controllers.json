{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.r2d2.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "move": "query.is_moving"
            }
          ]
        },
        "move": {
          "animations": [
            "move"
          ],
          "transitions": [
            {
              "idle": "!query.is_moving"
            }
          ]
        }
      }
    },
    "controller.animation.r2d2.holo": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "on": "query.property('r2d2:holo_active')"
            }
          ]
        },
        "on": {
          "animations": [
            "holo"
          ],
          "transitions": [
            {
              "off": "!query.property('r2d2:holo_active')"
            }
          ]
        }
      }
    }
  }
}
