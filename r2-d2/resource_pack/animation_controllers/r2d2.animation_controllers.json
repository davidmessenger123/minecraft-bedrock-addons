{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.r2d2.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "move": "query.is_moving"
            }
          ]
        },
        "move": {
          "animations": [
            "move"
          ],
          "transitions": [
            {
              "idle": "!query.is_moving"
            }
          ]
        }
      }
    }
  }
}
