{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "cw:alloy_smelter",
      "menu_category": {
        "category": "items"
      },
      "states": {
        "cw:status": [
          "idle",
          "working",
          "blocked"
        ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.cw.alloy_smelter",
      "minecraft:material_instances": {
        "*": {
          "texture": "cw_blocks",
          "render_method": "opaque",
          "face_dimming": true,
          "ambient_occlusion": true
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 4
      },
      "minecraft:light_emission": 5,
      "minecraft:light_dampening": 15,
      "minecraft:map_color": "#59616d",
      "minecraft:display_name": "tile.cw:alloy_smelter.name",
      "minecraft:loot": "loot_tables/blocks/alloy_smelter.json",
      "minecraft:block_entity": {
        "dynamic_properties": true
      },
      "cw:machine": {},
      "minecraft:tick": {
        "interval_range": [
          10,
          20
        ],
        "looping": true
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('cw:status') == 'working'",
        "components": {
          "minecraft:light_emission": 15
        }
      },
      {
        "condition": "q.block_state('cw:status') == 'blocked'",
        "components": {
          "minecraft:light_emission": 8
        }
      }
    ]
  }
}
