{
  "format_version": "1.26.60",
  "minecraft:block": {
    "description": {
      "identifier": "cw:transformer",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "cw:status": [
          "idle",
          "working",
          "blocked"
        ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.cw.transformer",
      "minecraft:material_instances": {
        "*": {
          "texture": "cw_blocks",
          "render_method": "opaque",
          "face_dimming": true,
          "ambient_occlusion": true
        }
      },
      "minecraft:item_visual": {
        "geometry": "geometry.cw.transformer",
        "material_instances": {
          "*": {
            "texture": "cw_blocks",
            "render_method": "opaque",
            "face_dimming": true,
            "ambient_occlusion": true
          }
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 4
      },
      "minecraft:light_emission": 4,
      "minecraft:light_dampening": 15,
      "minecraft:map_color": "#59616d",
      "minecraft:display_name": "tile.cw:transformer.name",
      "minecraft:loot": "loot_tables/blocks/transformer.json",
      "minecraft:block_entity": {
        "dynamic_properties": true
      },
      "cw:machine": {},
      "minecraft:tick": {
        "interval_range": [
          20,
          20
        ],
        "looping": true
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('cw:status') == 'working'",
        "components": {
          "minecraft:light_emission": 15
        }
      },
      {
        "condition": "q.block_state('cw:status') == 'blocked'",
        "components": {
          "minecraft:light_emission": 8
        }
      }
    ]
  }
}
